# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o Git.

# Supabase > botão "Connect" no topo do projeto (ou Project Settings > Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase > Project Settings > API Keys > Secret keys. SÓ no servidor, nunca compartilhe.
SUPABASE_SECRET_KEY=sb_secret_...

# IGDB (jogos): dev.twitch.tv > Console > Applications > Register Your Application
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# TMDB (filmes e séries): themoviedb.org > Configurações > API > "API Read Access Token"
TMDB_TOKEN=
